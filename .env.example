# TogetherPlay Firebase Configuration
# Replace these values with your actual Firebase project settings from the Firebase Console:
# Project Settings > General > Your apps > Web app

VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=togetherplay-prod.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=togetherplay-prod
VITE_FIREBASE_STORAGE_BUCKET=togetherplay-prod.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
